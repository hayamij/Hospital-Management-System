# API mode (real dependencies only)
DB_CLIENT=mssql

# SQL Server (SSMS)
MSSQL_SERVER=YOUR_SERVER
MSSQL_USER=YOUR_USERNAME
MSSQL_PASSWORD=YOUR_PASSWORD
MSSQL_DATABASE=HospitalManagementSystem
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERT=true
MSSQL_POOL_IDLE_MS=30000

# Auth
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_MS=604800000
